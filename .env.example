PORT=3000
DATABASE_URL=postgres://postgres:your_password@localhost:5432/pronoobs
# Set this to a long random secret. Send it as the X-API-Key header for write requests.
ADMIN_API_KEY=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API, for example https://pronoobs.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Optional persistent directory for uploaded team logos. Defaults to backend/uploads.
UPLOAD_DIR=
